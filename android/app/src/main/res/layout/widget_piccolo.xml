<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_hero_scuro"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/etichetta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="OGGI"
            android:textColor="#FF160304"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/icona"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/titolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="44dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Avidididadi"
            android:textColor="#FF160304"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sottotitolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="44dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF160304"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:background="@drawable/widget_tondo"
        android:contentDescription="Inizia l'allenamento"
        android:padding="11dp"
        android:src="@drawable/ic_widget_play" />
</FrameLayout>
