<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: i dati dell'app non vanno nel backup su Google né nel
     trasferimento verso un nuovo telefono. Per spostarli c'è il backup
     dell'app (Profilo → Dati e collegamenti). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
